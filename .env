# ==============================================================================
# Trident Unified Environment Configuration (Development & Production)
# ==============================================================================

# ── AI Providers ─────────────────────────────────────────────────────────────
# Provide your active OpenAI and Google Gemini API keys below
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Frontier Vision-Language Model Selection ────────────────────────────────
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.0-flash

# ── Layout Detection & DocLayNet ─────────────────────────────────────────────
# Leave empty to auto-download yolov8x-doclaynet.pt on first run
LAYOUT_MODEL_PATH=

# ── Preprocessing & Triage Parameters ────────────────────────────────────────
MIN_DPI=200
TEXT_CHAR_THRESHOLD=12

# ── Routing & Zero-CORS Configuration ────────────────────────────────────────
# FRONTEND_ORIGIN: Allowed origins for direct API access
FRONTEND_ORIGIN=http://localhost:3000,http://localhost

# NEXT_PUBLIC_API_URL: Leave empty for zero-CORS relative proxying via Nginx
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_URL=
