# ── AI Providers ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# ── Model Names (override if using different versions) ───────
OPENAI_MODEL=gpt-5
GOOGLE_MODEL=gemini-3

# ── Layout Detection ─────────────────────────────────────────
# Leave blank to auto-download yolov8x-doclaynet.pt on first run
LAYOUT_MODEL_PATH=

# ── Processing Parameters ────────────────────────────────────
MIN_DPI=200
TEXT_CHAR_THRESHOLD=12

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
